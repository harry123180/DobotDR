{
  "module_id": "PGC夾爪直接串口模式",
  "rtu_connection": {
    "port": "COM3",
    "baudrate": 115200,
    "parity": "N",
    "stopbits": 1,
    "timeout": 0.5
  },
  "grippers": {
    "PGC": {
      "unit_id": 6,
      "enabled": true
    }
