核心轉換要求
1. logging配置標準

import logging
import os
from logging.handlers import RotatingFileHandler

def setup_logging(module_name):
    """統一設置logging配置"""
    # 日誌目錄：執行檔同層目錄下的logs資料夾
    log_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'logs')
    os.makedirs(log_dir, exist_ok=True)
    
    # 格式化器
    formatter = logging.Formatter(
        '%(asctime)s [%(levelname)s] %(name)s:%(funcName)s:%(lineno)d - %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )
    
    # 文件處理器 (輪替日誌，保存一週)
    file_handler = RotatingFileHandler(
        os.path.join(log_dir, f'{module_name}.log'),
        maxBytes=10*1024*1024,  # 10MB
        backupCount=7,          # 保留7個檔案
        encoding='utf-8'
    )
    file_handler.setFormatter(formatter)
    
    # 控制台處理器
    console_handler = logging.StreamHandler()
    console_handler.setFormatter(formatter)
    
    # 配置logger
    logger = logging.getLogger(module_name)
    logger.setLevel(logging.DEBUG)
    logger.addHandler(file_handler)
    logger.addHandler(console_handler)
    
    return logger
print()轉換對應表 請根據以下級別對應表進行精確轉換： 原始print內容類型 轉換為logging級別 範例 正常啟動/連接成功 logger.info() print("模組啟動成功") → logger.info("模組啟動成功") 警告/重試/異常狀態 logger.warning() print("連接失敗，重試中") → logger.warning("連接失敗，重試中") 錯誤/失敗/異常 logger.error() print(f"異常: {e}") → logger.error(f"異常: {e}", exc_info=True) 除錯/狀態資訊 logger.debug() print(f"讀取寄存器: {value}") → logger.debug(f"讀取寄存器: {value}") 重要系統事件 logger.critical() print("系統緊急停止") → logger.critical("系統緊急停止")
異常處理強化 所有try-except區塊必須改為：
# 原本
except Exception as e:
    print(f"錯誤: {e}")

# 改為
except Exception as e:
    logger.error(f"錯誤: {e}", exc_info=True)  # exc_info=True記錄完整堆疊追蹤
執行緒相關日誌 特別關注以下執行緒生命週期日誌：
執行緒啟動：logger.info("主循環執行緒已啟動")
執行緒停止：logger.info("主循環執行緒已停止")
執行緒異常：logger.error("執行緒意外終止", exc_info=True)
連接狀態監控 所有網路/串口/Modbus連接都需要詳細日誌：
連接嘗試：logger.info(f"正在連接 {host}:{port}")
連接成功：logger.info("連接建立成功")
連接失敗：logger.warning("連接失敗，將在主循環中重試")
重連機制：logger.info("開始重連程序") 重點注意事項 記憶體管理考量
