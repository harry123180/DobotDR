  "timing": {
    "command_delay": 0.01,
    "status_cache_timeout": 0.05,
    "operation_timeout": 5.0,
    "quick_timeout": 2.0
  },
  "performance": {
    "enable_cache": true,
    "max_retries": 3,
    "retry_delay": 0.1
  }
}